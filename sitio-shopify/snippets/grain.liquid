{%- comment -%}
  Textura granulada. Uso: {% render 'grain', id: 'grainHero1', opacity: 0.22, blend: 'multiply' %}
{%- endcomment -%}
<svg class="grain" aria-hidden="true" focusable="false" style="opacity: {{ opacity | default: 0.22 }}; mix-blend-mode: {{ blend | default: 'multiply' }};"><filter id="{{ id }}"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter><rect width="100%" height="100%" filter="url(#{{ id }})"></rect></svg>
