{% layout 'password' %}
<section class="login">
  <div class="login__panel">
    {% render 'grain', id: 'grainPassword', opacity: 0.35, blend: 'overlay' %}
    <p class="eyebrow eyebrow--light">Muy pronto</p>
    <div class="login__copy">
      <h1 class="login__title"><span class="it">Estamos preparando</span> algo que todavía no ves.</h1>
      {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    </div>
    {% render 'logo', light: true, height: 32 %}
  </div>
  <div class="login__form-wrap">
    {%- form 'storefront_password', class: 'login__form' -%}
      <div class="login__head"><p class="eyebrow">Acceso</p><h2 class="h2">Entrar con contraseña</h2></div>
      {%- if form.errors -%}<div class="contact-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="field"><span class="field__label">Contraseña</span><input type="password" name="password" autocomplete="current-password" required></label>
      <button type="submit" class="btn btn--pink btn--lg">Entrar →</button>
    {%- endform -%}
  </div>
</section>
