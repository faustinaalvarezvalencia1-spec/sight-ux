<section id="laboratorio" class="lab" data-tabs>
  <div class="wrap">
    <div class="lab__head">
      <div>
        <p class="eyebrow eyebrow--lime">{{ section.settings.eyebrow }}</p>
        <h1 class="display lab__title">{{ section.settings.title }}</h1>
      </div>
      <p class="lab__intro">{{ section.settings.intro }}</p>
    </div>

    <div class="lab__tabs" role="tablist" aria-label="Proyectos">
      {%- for block in section.blocks -%}
        <button type="button" class="lab__tab{% if forloop.first %} is-active{% endif %}" role="tab" id="tab-{{ block.id }}" aria-controls="panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} data-tab>{{ block.settings.name }}</button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign bs = block.settings -%}
      <div class="lab__panel" role="tabpanel" id="panel-{{ block.id }}" aria-labelledby="tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
        <div class="lab__panel-head">
          <div>
            <p class="eyebrow">Caso · {{ bs.sector }}</p>
            <h2 class="h2">{{ bs.name }}</h2>
          </div>
          {%- if bs.link != blank -%}<a class="btn btn--ink" href="{{ bs.link }}">Ver caso completo</a>{%- endif -%}
        </div>
        <ol class="lab__steps" aria-label="Diagnóstico del caso">
          <li><span class="lab__step-line"><span class="lab__step-dot"></span><span class="lab__step-rule"></span></span><span class="lab__step-num">01</span><span class="lab__step-name">Síntoma</span><span class="lab__step-text">{{ bs.symptom }}</span></li>
          <li><span class="lab__step-line"><span class="lab__step-dot"></span><span class="lab__step-rule"></span></span><span class="lab__step-num">02</span><span class="lab__step-name">Causa raíz</span><span class="lab__step-text">{{ bs.cause }}</span></li>
          <li><span class="lab__step-line"><span class="lab__step-dot"></span><span class="lab__step-rule"></span></span><span class="lab__step-num">03</span><span class="lab__step-name">Tratamiento</span><span class="lab__step-text">{{ bs.treatment }}</span></li>
          <li><span class="lab__step-line"><span class="lab__step-dot lab__step-dot--end"></span></span><span class="lab__step-num">04</span><span class="lab__step-name">Resultado</span><span class="lab__step-text">{{ bs.result }}</span></li>
        </ol>
        <div class="lab__body">
          <div class="lab__gallery" data-gallery>
            {%- assign imgs = 0 -%}
            {%- for i in (1..3) -%}
              {%- capture k -%}image{{ i }}{%- endcapture -%}
              {%- if bs[k] != blank -%}
                {%- assign imgs = imgs | plus: 1 -%}
                <div class="lab__slide{% if imgs == 1 %} is-active{% endif %}" data-gslide>{{ bs[k] | image_url: width: 1400 | image_tag: alt: bs.name }}</div>
              {%- endif -%}
            {%- endfor -%}
            {%- if imgs == 0 -%}
              <div class="lab__slide lab__slide--empty is-active">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18"></rect><circle cx="9" cy="9" r="2"></circle><path d="M21 15l-5-5L5 21"></path></svg>
                <p>Portafolio {{ bs.name }}</p>
                <p class="caption">[ imagen del proyecto ]</p>
              </div>
            {%- elsif imgs > 1 -%}
              <div class="lab__gdots">
                {%- for i in (1..imgs) -%}<button type="button" class="lab__gdot{% if forloop.first %} is-active{% endif %}" aria-label="Imagen {{ i }}" data-gdot="{{ forloop.index0 }}"><span></span></button>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          <div class="lab__result">
            <div class="lab__metric">
              <span class="eyebrow">Resultado medido</span>
              <span class="lab__metric-value">{{ bs.metric }}</span>
              <span class="lab__metric-label">{{ bs.metric_label }}</span>
              <span class="caption">{{ bs.method }}</span>
            </div>
            {%- assign b1 = bs.bar1 | default: 0 -%}{%- assign b2 = bs.bar2 | default: 0 -%}{%- assign b3 = bs.bar3 | default: 0 -%}
            {%- assign bmax = b1 -%}{%- if b2 > bmax -%}{%- assign bmax = b2 -%}{%- endif -%}{%- if b3 > bmax -%}{%- assign bmax = b3 -%}{%- endif -%}
            <div class="bars" role="img" aria-label="Antes {{ b1 }}, mes 3 {{ b2 }}, mes 6 {{ b3 }}">
              {%- for v in (1..3) -%}
                {%- case v -%}{%- when 1 -%}{%- assign val = b1 -%}{%- when 2 -%}{%- assign val = b2 -%}{%- else -%}{%- assign val = b3 -%}{%- endcase -%}
                {%- if bmax > 0 -%}{%- assign hgt = val | times: 96 | divided_by: bmax -%}{%- else -%}{%- assign hgt = v | times: 32 -%}{%- endif -%}
                <div class="bar"><span class="bar__val">{% if bmax > 0 %}{{ val }}{% else %}[00]{% endif %}</span><span class="bar__fill bar__fill--{{ v }}" style="height: {{ hgt }}px;"></span></div>
              {%- endfor -%}
            </div>
            <div class="bars__labels"><span>Antes</span><span>Mes 3</span><span>Mes 6</span></div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "sight lab",
  "class": "section-lab",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Laboratorio" },
    { "type": "text", "id": "title", "label": "Título", "default": "sight lab" },
    { "type": "textarea", "id": "intro", "label": "Introducción", "default": "Cada caso, contado igual: síntoma, causa raíz, tratamiento y resultado. Abre una carpeta." }
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Caso",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "name", "label": "Cliente" },
        { "type": "text", "id": "sector", "label": "Sector", "default": "[Sector del cliente]" },
        { "type": "textarea", "id": "symptom", "label": "Síntoma", "default": "[Lo que el cliente notaba]" },
        { "type": "textarea", "id": "cause", "label": "Causa raíz", "default": "[Lo que encontramos al diagnosticar]" },
        { "type": "textarea", "id": "treatment", "label": "Tratamiento", "default": "[Las decisiones de diseño que tomamos]" },
        { "type": "textarea", "id": "result", "label": "Resultado", "default": "[El cambio medible]" },
        { "type": "image_picker", "id": "image1", "label": "Imagen 1" },
        { "type": "image_picker", "id": "image2", "label": "Imagen 2" },
        { "type": "image_picker", "id": "image3", "label": "Imagen 3" },
        { "type": "text", "id": "metric", "label": "Resultado medido", "default": "[+00%]" },
        { "type": "text", "id": "metric_label", "label": "Indicador", "default": "[Indicador principal del caso]" },
        { "type": "text", "id": "method", "label": "Método de medición", "default": "[Método, muestra y periodo de la medición]" },
        { "type": "number", "id": "bar1", "label": "Valor antes" },
        { "type": "number", "id": "bar2", "label": "Valor mes 3" },
        { "type": "number", "id": "bar3", "label": "Valor mes 6" },
        { "type": "url", "id": "link", "label": "Enlace al caso completo" }
      ]
    }
  ],
  "presets": [ { "name": "sight lab" } ]
}
{% endschema %}
